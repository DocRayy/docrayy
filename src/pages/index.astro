---
import Layout from '../layouts/Layout.astro'
import { Image } from 'astro:assets'
import heroImage from '../../public/images/hero1.png'
import siluet from '../../public/images/siluet.jpg'
import { Icon } from 'astro-icon/components'
import ProjectCard from '../components/ProjectCard.astro'
import projectsData from '../data/project.json'

const featuredProjects = projectsData.slice(0, 6)

const experiences = [
  {
    company: 'PT. Sat Nusapersada Tbk.',
    role: 'Frontend Developer',
    start: 'Feb 2026',
    end: 'Aug 2026',
    image: '/images/experience/satnusa.jpg',
    description:
      'Saya mengembangkan, memelihara, dan mengoptimalkan aplikasi manufaktur internal menggunakan React, Tailwind CSS, serta integrasi API backend melalui kolaborasi tim untuk mendukung proses bisnis dan produksi secara efisien.',
  },
  {
    company: 'Folxcode',
    role: 'Frontend Developer',
    start: 'Aug 2025',
    end: 'Jan 2026',
    image: '/images/experience/folxcode.png',
    description:
      'Saya mengembangkan, memelihara, dan mengoptimalkan antarmuka pengguna yang responsif untuk proyek klien maupun internal menggunakan Angular 20 dan Tailwind CSS, serta mengintegrasikannya dengan API backend guna mendukung alur kerja pengelolaan data.',
  },
  {
    company: 'IFATIVE',
    role: 'Web Programmer',
    start: 'Sep 2024',
    end: 'Apr 2025',
    image: '/images/experience/ifative.webp',
    description:
      'Saya mengembangkan dan memelihara aplikasi web responsif untuk proyek klien maupun internal menggunakan Laravel, Next.js, Strapi, Tailwind CSS, dan MySQL melalui kolaborasi tim di seluruh tahapan pengembangan.',
  },
  {
    company: 'Radio Republik Indonesia Tanjungpinang',
    role: 'Office Engineer',
    start: 'Okt 2021',
    end: 'Des 2021',
    image: '/images/experience/rri.webp',
    description:
      'Saya mendukung produksi siaran radio dengan merekam dan menyunting konten audio menggunakan Adobe Audition, sekaligus mengembangkan serta memelihara aplikasi web absensi karyawan untuk efisiensi administrasi internal.',
  },
]
---

<Layout>
  <div class="bg-background-secondary overflow-hidden">
    <!-- ===== HERO ===== -->
    <section id="hero" class="relative min-h-screen">
      <div class="relative mx-auto h-screen">
        <!-- Heading + tagline + badges -->
        <div
          class="absolute z-30
                 left-[4%] top-[6%] w-[60%]
                 sm:left-[4%] sm:top-[20%] sm:max-w-[38%]
                 md:left-[4%] md:top-[20%] md:max-w-[38%]"
        >
          <h1
            class="font-display font-extrabold text-heading leading-tight animate-fade-right animate-once animate-ease-out
                   text-xl
                   sm:text-2xl
                   md:text-4xl
                   lg:text-4xl"
          >
            I build fast, reliable web apps end to end — from database to pixel.
          </h1>
          <p
            class="mt-3 text-heading animate-fade-right animate-once animate-delay-500 animate-ease-out
                   text-sm
                   sm:text-base sm:mt-5
                   md:text-xl md:mt-5
                   lg:text-xl"
          >
            React · Next.js · Laravel · Angular · Node.js · MySQL
          </p>
          <p
            class="mt-1 text-heading animate-fade-right animate-once animate-delay-1000 animate-ease-out
                   text-sm
                   sm:text-base sm:mt-2
                   md:text-xl md:mt-2
                   lg:text-xl"
          >
            Indonesia · Open to work
          </p>
          <div
            class="flex flex-row flex-wrap gap-2 mt-4
                   sm:absolute sm:flex-col sm:gap-3
                   sm:right-[calc(-100%-3rem)] sm:top-0"
          >
            <div class="badge badge-neutral badge-sm sm:badge-xl text-white">
              2+ years experience
            </div>
            <div class="badge badge-neutral badge-sm sm:badge-xl text-white">
              10+ projects shipped
            </div>
          </div>
        </div>

        <!-- Name -->
        <div
          class="absolute left-0 bottom-0 w-full z-10
                 px-[4%]
                 sm:px-[4%]
                 md:px-[4%]"
        >
          <h2
            class="font-display animate-fade-up animate-once animate-ease-out font-extrabold text-[#5A3E37] uppercase leading-[0.88] tracking-tight
                   text-3xl
                   sm:text-5xl
                   md:text-7xl
                   lg:text-8xl"
          >
            Rayyan<br />Kheisar Syaifullah
          </h2>
        </div>

        <!-- Web Developer label -->
        <span
          class="font-label animate-fade-up animate-once animate-ease-out absolute z-20 text-heading tracking-[0.3em] uppercase
                 right-[4%] bottom-[12%] text-sm
                 sm:right-[14%] sm:bottom-[15%] sm:text-lg
                 md:right-[14%] md:bottom-[15%] md:text-2xl
                 lg:right-[14%] lg:bottom-[15%] lg:text-2xl"
        >
          Web Developer
        </span>

        <Image
          src={heroImage}
          alt="Rayyan Hero"
          class="absolute left-1/2 -translate-x-1/2 bottom-0 w-auto select-none object-contain object-bottom
                 h-[55%]
                 sm:h-[70%]
                 md:h-[85%]
                 lg:h-[95%]"
          fetchpriority="high"
          loading="eager"
        />
      </div>
    </section>

    <!-- ===== ABOUT ===== -->
    <section id="about">
      <div
        class="flex flex-col py-16 sm:py-26 items-center justify-center text-body"
      >
        <div
          class="gap-5 flex flex-col items-center justify-center px-6 opacity-0"
          data-animate="fade-up"
        >
          <h2 class="uppercase text-xl sm:text-2xl font-bold">About Me</h2>
          <div class="h-0.5 w-full max-w-200 bg-heading"></div>
        </div>
        <div
          class="gap-7 mt-10 sm:mt-16 flex flex-col items-center justify-center px-6"
        >
          <h2
            class="font-bold opacity-0 text-xl sm:text-2xl md:text-4xl text-center"
            data-animate="fade-up"
          >
            Where Curiosity Meets Clean Code
          </h2>
          <p
            class="text-base sm:text-lg md:text-xl w-full text-center opacity-0"
            data-animate="fade-up"
            data-delay="500"
          >
            Just a Software Engineer who loves turning ideas into working
            products. Enjoys exploring Web Development and UI/UX Design.
          </p>
        </div>
      </div>
      <div
        class="bg-body text-background-secondary flex flex-col items-center justify-center py-10 sm:py-12 gap-7"
      >
        <div
          class="gap-7 sm:gap-10 flex flex-col items-center justify-center px-6"
        >
          <h2
            class="uppercase text-2xl sm:text-4xl font-bold text-center opacity-0"
            data-animate="fade-up"
          >
            My Approach
          </h2>
          <p
            class="text-base sm:text-lg md:text-xl w-full text-center opacity-0"
            data-animate="fade-up"
            data-delay="300"
          >
            Just a Software Engineer who loves turning ideas into working
            products. Enjoys exploring Web Development and UI/UX Design.
          </p>
        </div>
        <div
          class="card bg-white text-body w-[90%] md:w-[60%] shadow-sm mx-6 sm:mx-0 opacity-0"
          data-animate="fade-up"
          data-delay="500"
        >
          <div class="card-body grid grid-cols-1 sm:grid-cols-2 gap-4">
            <span class="flex items-center gap-2">
              <Icon name="lucide:check" class="size-5 text-heading shrink-0" />
              Clean & maintainable code
            </span>
            <span class="flex items-center gap-2">
              <Icon name="lucide:check" class="size-5 text-heading shrink-0" />
              User-centered design approach
            </span>
            <span class="flex items-center gap-2">
              <Icon name="lucide:check" class="size-5 text-heading shrink-0" />
              Agile development workflow
            </span>
            <span class="flex items-center gap-2">
              <Icon name="lucide:check" class="size-5 text-heading shrink-0" />
              Continuous learning mindset
            </span>
          </div>
        </div>
      </div>
    </section>

    <!-- ===== EDUCATION / SKILLS / EXPERIENCE ===== -->
    <section id="education">
      <div
        class="flex flex-col py-16 sm:py-30 items-center justify-center text-body"
      >
        <div
          class="grid grid-cols-3 gap-2 sm:gap-4 md:gap-6 px-6 w-full max-w-xl opacity-0"
          data-animate="fade-up"
          data-tabs
        >
          <button
            data-tab="education"
            class="btn btn-accent btn-xs sm:btn-sm md:btn-md lg:btn-lg xl:btn-xl w-full"
            >Education</button
          >
          <button
            data-tab="skills"
            class="btn btn-outline btn-accent btn-xs sm:btn-sm md:btn-md lg:btn-lg xl:btn-xl w-full"
            >Skills</button
          >
          <button
            data-tab="experience"
            class="btn btn-outline btn-accent btn-xs sm:btn-sm md:btn-md lg:btn-lg xl:btn-xl w-full"
            >Experience</button
          >
        </div>

        <div
          class="relative overflow-hidden w-full sm:w-[80%] md:w-[60%] mt-10 sm:mt-15 px-6 sm:px-0"
        >
          <!-- Education -->
          <div
            data-panel="education"
            class="text-body shadow-sm flex flex-col gap-2"
          >
            <div class="card bg-background-card">
              <div class="card-body gap-5">
                <div class="flex items-start gap-3">
                  <div>
                    <p class="font-bold text-lg sm:text-xl text-heading">
                      Diploma IV — Software Engineering
                    </p>
                    <p class="text-muted text-sm sm:text-base">
                      Politeknik Negeri Batam (Polibatam)
                    </p>
                    <p class="text-muted text-sm sm:text-base">
                      2022 – 2026 · GPA 3.89
                    </p>
                  </div>
                </div>
              </div>
            </div>
            <div class="card bg-background-card">
              <div class="card-body gap-5">
                <div class="flex items-start gap-3">
                  <div>
                    <p class="font-bold text-lg sm:text-xl text-heading">
                      SMKN 4 Tanjungpinang — Software Engineering
                    </p>
                    <p class="text-muted text-sm sm:text-base">2018 – 2022</p>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Skills -->
          <div data-panel="skills" class="text-body shadow-sm hidden">
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
              <div class="card bg-white">
                <div class="card-body flex flex-col gap-3 items-center">
                  <h2
                    class="uppercase font-bold mb-2 sm:mb-6 text-lg sm:text-xl"
                  >
                    Frontend
                  </h2>
                  {
                    [
                      'HTML',
                      'CSS',
                      'Tailwind',
                      'Javascript',
                      'React',
                      'Next.js',
                      'Laravel',
                      'Angular',
                    ].map((skill) => (
                      <span class="badge badge-outline border-border text-body justify-center w-full">
                        {skill}
                      </span>
                    ))
                  }
                </div>
              </div>
              <div class="card bg-white">
                <div class="card-body flex flex-col gap-3 items-center">
                  <h2
                    class="uppercase font-bold mb-2 sm:mb-6 text-lg sm:text-xl"
                  >
                    Backend & Database
                  </h2>
                  {
                    ['SQL', 'REST API', 'PHP', 'Node.js'].map((skill) => (
                      <span class="badge badge-outline border-border text-body justify-center w-full">
                        {skill}
                      </span>
                    ))
                  }
                </div>
              </div>
              <div class="card bg-white">
                <div class="card-body flex flex-col gap-3 items-center">
                  <h2
                    class="uppercase font-bold mb-2 sm:mb-6 text-lg sm:text-xl"
                  >
                    Tools
                  </h2>
                  {
                    [
                      'Visual Studio Code',
                      'Git',
                      'GitHub',
                      'Figma',
                      'Postman',
                    ].map((skill) => (
                      <span class="badge badge-outline border-border text-body justify-center w-full">
                        {skill}
                      </span>
                    ))
                  }
                </div>
              </div>
            </div>
          </div>

          <!-- Experience -->
          <div data-panel="experience" class="text-body hidden">
            <div
              class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6"
            >
              {
                experiences.map((exp) => (
                  <div class="group relative h-72 sm:h-80 lg:h-95 w-full overflow-hidden rounded-xl shadow-sm cursor-pointer">
                    <div
                      class="absolute inset-0 bg-cover bg-center transition-transform duration-500 ease-out group-hover:scale-105"
                      style={`background-image:url(${exp.image})`}
                    />

                    <div class="absolute inset-0 bg-black/35 transition-colors duration-500 ease-out group-hover:bg-black/70" />

                    <div class="absolute inset-0 flex flex-col items-center justify-center gap-1 px-4 sm:px-6 text-center transition-all duration-500 ease-out group-hover:opacity-0 group-hover:-translate-y-3">
                      <p class="font-display text-lg sm:text-xl font-bold text-white">
                        {exp.company}
                      </p>
                      <p class="text-xs sm:text-sm text-white/90">{exp.role}</p>
                      <p class="text-xs sm:text-sm text-white/80">
                        {exp.start} - {exp.end}
                      </p>
                    </div>

                    <div class="absolute inset-0 flex items-center justify-center px-5 sm:px-7 text-center opacity-0 translate-y-3 transition-all duration-500 ease-out group-hover:opacity-100 group-hover:translate-y-0">
                      <p class="text-xs sm:text-sm leading-relaxed text-white">
                        {exp.description}
                      </p>
                    </div>
                  </div>
                ))
              }
            </div>
          </div>
        </div>

        <!-- Stats bar -->
        <div
          class="mt-10 sm:mt-15 flex flex-col sm:flex-row w-full items-stretch opacity-0"
          data-animate="fade-up"
          data-delay="300"
        >
          <div class="self-stretch hidden sm:block">
            <Image
              src={siluet}
              alt="Rayyan Siluet"
              class="h-60 w-auto object-contain select-none"
              aria-label="Rayyan-siluet"
            />
          </div>
          <div
            class="grid flex-1 grid-cols-1 sm:grid-cols-3 gap-4 sm:gap-6 bg-heading text-background px-6 py-6 sm:py-0"
          >
            <div
              class="flex flex-col items-center justify-center gap-2 sm:gap-4 text-center"
            >
              <p class="font-display text-4xl sm:text-6xl font-extrabold">
                10+
              </p>
              <p class="text-base sm:text-xl uppercase">Completed Projects</p>
            </div>
            <div
              class="flex flex-col items-center justify-center gap-2 sm:gap-4 text-center"
            >
              <p class="font-display text-4xl sm:text-6xl font-extrabold">4+</p>
              <p class="text-base sm:text-xl uppercase">Work Experience</p>
            </div>
            <div
              class="flex flex-col items-center justify-center gap-2 sm:gap-4 text-center"
            >
              <p class="font-display text-4xl sm:text-6xl font-extrabold">2+</p>
              <p class="text-base sm:text-xl uppercase">Certifications</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ===== PORTFOLIO ===== -->
    <section id="portofolio">
      <div class="flex flex-col py-10 px-6 sm:px-10 md:px-15 text-body">
        <div
          class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 opacity-0"
          data-animate="fade-up"
        >
          <h2 class="uppercase text-2xl sm:text-4xl font-bold">
            Our Portofolio
          </h2>
          <a
            href="/projects"
            class="group flex gap-2 items-center uppercase text-heading transition-colors hover:text-primary-hover"
          >
            See all
            <Icon
              name="lucide:move-right"
              class="size-5 text-heading transition-transform duration-300 group-hover:translate-x-1"
            />
          </a>
        </div>
        <div
          class="mt-6 sm:mt-10 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6 opacity-0"
          data-animate="fade-up"
          data-delay="300"
        >
          {featuredProjects.map((project) => <ProjectCard project={project} />)}
        </div>
      </div>
    </section>

    <script>
      const ORDER = ['education', 'skills', 'experience']
      const buttons = Array.from(
        document.querySelectorAll<HTMLButtonElement>('[data-tab]'),
      )
      const panels: Record<string, HTMLElement> = {}
      for (const el of document.querySelectorAll<HTMLElement>('[data-panel]')) {
        if (el.dataset.panel) panels[el.dataset.panel] = el
      }

      let current = 'education'
      let animating = false

      function setActive(name: string) {
        for (const btn of buttons) {
          const isActive = btn.dataset.tab === name
          btn.classList.toggle('btn-accent', isActive)
          btn.classList.toggle('btn-outline', !isActive)
          btn.classList.toggle('btn-neutral', !isActive)
        }
      }

      function switchTab(target: string) {
        if (animating || target === current || !panels[target]) return
        animating = true

        const dir = ORDER.indexOf(target) > ORDER.indexOf(current) ? 1 : -1
        const oldPanel = panels[current]
        const newPanel = panels[target]
        current = target

        setActive(target)

        oldPanel.style.transition =
          'transform 0.3s ease-in, opacity 0.3s ease-in'
        oldPanel.style.transform = `translateX(${-100 * dir}%)`
        oldPanel.style.opacity = '0'

        setTimeout(() => {
          oldPanel.classList.add('hidden')
          oldPanel.style.transform = ''
          oldPanel.style.opacity = ''
          oldPanel.style.transition = ''

          newPanel.classList.remove('hidden')
          newPanel.style.transition = 'none'
          newPanel.style.transform = `translateX(${100 * dir}%)`
          newPanel.style.opacity = '0'

          requestAnimationFrame(() => {
            requestAnimationFrame(() => {
              newPanel.style.transition =
                'transform 0.35s ease-out, opacity 0.35s ease-out'
              newPanel.style.transform = 'translateX(0)'
              newPanel.style.opacity = '1'

              setTimeout(() => {
                newPanel.style.transform = ''
                newPanel.style.opacity = ''
                newPanel.style.transition = ''
                animating = false
              }, 350)
            })
          })
        }, 300)
      }

      for (const btn of buttons) {
        btn.addEventListener('click', () => switchTab(btn.dataset.tab!))
      }

      // Scroll-triggered animations
      const animatedElements =
        document.querySelectorAll<HTMLElement>('[data-animate]')

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              const el = entry.target as HTMLElement
              const animation = el.dataset.animate
              const delay = el.dataset.delay || '0'

              el.style.animationDelay = `${delay}ms`
              el.classList.add(
                'animate-once',
                'animate-ease-out',
                `animate-${animation}`,
              )
              el.classList.remove('opacity-0')

              observer.unobserve(el)
            }
          })
        },
        { threshold: 0.15 },
      )

      animatedElements.forEach((el) => observer.observe(el))
    </script>
  </div>
</Layout>
