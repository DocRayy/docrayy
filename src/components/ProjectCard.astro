---
import { Image } from 'astro:assets'

interface Project {
  id: string
  title: string
  subtitle: string
  category: string
  framework: string[]
  tools: string[]
  cover: string
  description: string
  gallery: string[]
  color: string[]
}

interface Props {
  project: Project
  large?: boolean
}

const { project, large = false } = Astro.props
---

<a
  href={`/projects/${project.id}`}
  class:list={[
    'group card shadow-sm overflow-hidden transition-all duration-300 hover:-translate-y-1 hover:shadow-lg',
    large ? 'lg:min-h-105' : 'lg:min-h-72',
  ]}
>
  <figure
    class:list={['overflow-hidden', large ? 'lg:aspect-16/10' : 'aspect-auto']}
  >
    <Image
      src={project.cover}
      alt={`Cover of ${project.title}`}
      width="100"
      height="100"
      loading="lazy"
      class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
    />
  </figure>
  <div class="card-body gap-4">
    <div class="flex items-center justify-between">
      <span class="badge badge-outline text-muted text-xs uppercase">
        {project.category}
      </span>
      <span class="flex gap-1.5" title="Color palette">
        {
          project.color.map((color) => (
            <span
              class="size-4 rounded-full ring-1 ring-border"
              style={`background-color:${color};`}
            />
          ))
        }
      </span>
    </div>
    <div class="flex flex-col gap-1.5">
      <h3
        class="font-display font-bold text-xl text-heading transition-colors group-hover:text-primary-hover"
      >
        {project.title}
      </h3>
      <p class="text-sm text-body line-clamp-2">{project.subtitle}</p>
    </div>
    <div class="mt-auto flex flex-wrap gap-1.5">
      {
        project.framework.map((item) => (
          <span class="badge badge-sm badge-accent text-white border-none font-medium">
            {item}
          </span>
        ))
      }
    </div>
  </div>
</a>
