---
const pathname = Astro.url.pathname

const links = [
  { href: '/', label: 'Home' },
  { href: '/blogs', label: 'Blogs' },
  { href: '/journals', label: 'Journals' },
  { href: '/projects', label: 'Projects' },
  { href: '/tools', label: 'Tools' },
]
---

<header
  class="fixed top-6 left-1/2 -translate-x-1/2 z-50 bg-background/60 backdrop-blur-md border border-border max-w-lg flex items-center justify-center rounded-4xl px-10 shadow-lg hidden md:flex"
>
  <nav class="flex py-4">
    <ul class="flex items-center gap-8 text-sm">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              class:list={[
                'transition-colors hover:text-heading uppercase',
                pathname === link.href
                  ? 'text-heading font-bold'
                  : 'text-heading/50',
              ]}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
